#!/bin/sh
#
# PROVIDE: initial_setup
# REQUIRE: LOGIN FILESYSTEMS
# BEFORE: lightdm
# KEYWORD: shutdown

. /etc/rc.subr

name="initial_setup"
rcvar="${name}_enable"
start_cmd="${name}_start"
stop_cmd=":"

initial_setup_start()
{
    HOME=/root dbus-run-session -- \
        gsettings set org.mate.session required-components-list "['windowmanager']"
    HOME=/root dbus-run-session -- \
        gsettings set org.mate.background show-desktop-icons false

    mkdir -p /root/.setup-station-autostart

    cat > /root/.xinitrc <<'EOF'
ck-launch-session mate-session --autostart=/root/.setup-station-autostart &
exec setup-station-init
EOF
    chmod 755 /root/.xinitrc

    # Start X as root - this will block until setup-station-init exits
    su -l root -c "startx -- :0 vt09"

    rm -f /root/.xinitrc
    rmdir /root/.setup-station-autostart

    HOME=/root dbus-run-session -- \
        gsettings reset org.mate.session required-components-list
    HOME=/root dbus-run-session -- \
        gsettings reset org.mate.background show-desktop-icons
}

load_rc_config $name
run_rc_command "$1"
